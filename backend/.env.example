# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/circular_packaging_exchange

# JWT Authentication
JWT_ACCESS_SECRET=replace_with_a_secure_long_random_secret_for_access_token_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_long_random_secret_for_refresh_token_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Sentry Error Monitoring (Optional - Architecture Prepared)
SENTRY_DSN=

# Email Service (Optional - Architecture Prepared)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@circularexchange.local
